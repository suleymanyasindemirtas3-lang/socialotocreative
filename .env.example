# ---------- 1. URETIM (LLM) ----------
# Zincir: virgulle ayir, ilki cokerse sonraki denenir.
# Secenekler: ollama (yerel) | pollinations (anahtarsiz) | gemini | groq | claude | mock
LLM_PROVIDER=gemini,ollama
GEMINI_API_KEY=
# Alias kullan: model adlari sik degisiyor, "latest" kendini gunceller.
GEMINI_MODEL=gemini-flash-latest
# Dusunme modu: kapali daha hizli ve kotayi korur. 1 yaparsan kalite artar, kota erir.
GEMINI_THINKING=0
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---------- 2. GORSEL ----------
# pollinations (anahtarsiz, ucretsiz) | none
# Zincir: gemini istemi daha iyi takip eder, kota bitince pollinations devralir.
IMAGE_PROVIDER=gemini,pollinations
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# ---------- 3. PLATFORMLAR ----------
# Hesaplar panelden eklenir: npm run panel
# Kimlik bilgileri data/accounts.json icinde tutulur, .env icinde degil.

# ---------- 4. ONAY KAPISI ----------
# true olursa onay beklenmez, dogrudan yayinlanir
AUTO_APPROVE=false

# ---------- 5. MARKA / NIS ----------
BRAND_NICHE=haber, magazin, spor, sinema, muzik, oyun, anime, teknoloji ve yasam
BRAND_LANGUAGE=tr
BRAND_TONE=net, hizli, anlasilir, genis kitleye hitap eden

# ---------- 6. GUVENLIK ----------
# true iken hicbir sey gercekten yayinlanmaz, sadece loglanir
DRY_RUN=true
MAX_POSTS_PER_RUN=3

# ---------- 7. PANEL ----------
PANEL_TOKEN=
PANEL_PORT=8787
PANEL_HOST=127.0.0.1

# ---------- 8. MEDYA BARINDIRMA (sadece Instagram icin) ----------
# github | base | none  -> Instagram medyayi public URL olarak ister.
MEDIA_HOST=github
MEDIA_REPO=
MEDIA_BRANCH=main
PUBLIC_MEDIA_BASE=

# ---------- 9. SESLENDIRME ----------
# Zincir: ilki cokerse sonraki. edge (ucretsiz) | elevenlabs (ucretli)
TTS_PROVIDER=edge
TTS_VOICE=tr-TR-AhmetNeural
TTS_RATE=+8%
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ---------- 10. VIDEO GORUNTU KAYNAGI ----------
# still (ucretsiz: gorsel + Ken Burns) | fal (ucretli: AI video uretimi)
# Ucretliye gecerken ses/altyazi/format yerel kalir, yalniz goruntu maliyeti doger.
VIDEO_MAX_SANIYE=55
CLIP_SOURCE=still
FAL_API_KEY=
FAL_MODEL=fal-ai/ltx-video

# ---------- 11. GUNDEM KAYNAKLARI ----------
# Fikirler gercek gundeme dayanir; bos birakirsan model konu uydurur ve
# icerik jeneriklesir. hackernews | devto | github | rss
TREND_SOURCES=hackernews,devto,github
# MUDAHALE: kendi nisinin RSS adreslerini buraya virgulle ekle.
RSS_FEEDS=
TREND_LIMIT=20

# ---------- 12. SAGLIK IZLEME ----------
# Bu kadar saattir yayin yoksa "sessiz durus" alarmi verir.
SAGLIK_SESSIZLIK_SAAT=48
SAGLIK_MEDYA_LIMIT_MB=500
SAGLIK_TEMIZLIK_GUN=14
