# ---------- 1. URETIM (LLM) ----------
# Zincir: virgulle ayir, ilki cokerse sonraki denenir.
# Secenekler: ollama (yerel) | pollinations (anahtarsiz) | gemini | groq | claude | mock
LLM_PROVIDER=gemini,ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---------- 2. GORSEL ----------
# pollinations (anahtarsiz, ucretsiz) | none
IMAGE_PROVIDER=pollinations
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# ---------- 3. PLATFORMLAR ----------
# Hesaplar panelden eklenir: npm run panel
# Kimlik bilgileri data/accounts.json icinde tutulur, .env icinde degil.

# ---------- 4. ONAY KAPISI ----------
# true olursa onay beklenmez, dogrudan yayinlanir
AUTO_APPROVE=false

# ---------- 5. MARKA / NIS ----------
BRAND_NICHE=yazilim ve yapay zeka
BRAND_LANGUAGE=tr
BRAND_TONE=net, iddiali, jargonsuz

# ---------- 6. GUVENLIK ----------
# true iken hicbir sey gercekten yayinlanmaz, sadece loglanir
DRY_RUN=true
MAX_POSTS_PER_RUN=3

# ---------- 7. PANEL ----------
PANEL_TOKEN=
PANEL_PORT=8787
PANEL_HOST=127.0.0.1

# ---------- 8. MEDYA BARINDIRMA (sadece Instagram icin) ----------
# github | base | none  -> Instagram medyayi public URL olarak ister.
MEDIA_HOST=github
MEDIA_REPO=
MEDIA_BRANCH=main
PUBLIC_MEDIA_BASE=

# ---------- 9. SESLENDIRME ----------
# Zincir: ilki cokerse sonraki. edge (ucretsiz) | elevenlabs (ucretli)
TTS_PROVIDER=edge
TTS_VOICE=tr-TR-AhmetNeural
TTS_RATE=+8%
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ---------- 10. VIDEO GORUNTU KAYNAGI ----------
# still (ucretsiz: gorsel + Ken Burns) | fal (ucretli: AI video uretimi)
# Ucretliye gecerken ses/altyazi/format yerel kalir, yalniz goruntu maliyeti doger.
CLIP_SOURCE=still
FAL_API_KEY=
FAL_MODEL=fal-ai/ltx-video
