# ---------- 1. URETIM (LLM) ----------
# Zincir: virgulle ayir, ilki cokerse sonraki denenir.
# Secenekler: ollama (yerel) | pollinations (anahtarsiz) | gemini | groq | claude | mock
LLM_PROVIDER=ollama,pollinations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---------- 2. GORSEL ----------
# pollinations (anahtarsiz, ucretsiz) | none
IMAGE_PROVIDER=pollinations
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# ---------- 3. PLATFORMLAR ----------
# Virgulle ayrilmis: console,telegram,bluesky
TARGETS=console

BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE=https://bsky.social

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- 4. ONAY KAPISI ----------
# true olursa Telegram onayi beklenmez, dogrudan yayinlanir
AUTO_APPROVE=false
# Onay isteklerinin gonderilecegi kanal (su an sadece telegram)
APPROVAL_CHANNEL=telegram

# ---------- 5. MARKA / NIS ----------
BRAND_NICHE=yazilim ve yapay zeka
BRAND_LANGUAGE=tr
BRAND_TONE=net, iddiali, jargonsuz

# ---------- 6. GUVENLIK ----------
# true iken hicbir sey gercekten yayinlanmaz, sadece loglanir
DRY_RUN=true
MAX_POSTS_PER_RUN=3
